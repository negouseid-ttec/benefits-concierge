{
  "name": "benefits-concierge",
  "version": "1.0.0",
  "description": "Omnichannel AI agent for government benefits communication — SMS, RCS, WhatsApp, and email",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.ts",
    "cdk": "cdk",
    "lint": "eslint . --ext .ts",
    "synth": "cdk synth",
    "deploy": "cdk deploy --all",
    "setup:rcs": "ts-node scripts/setup-rcs.ts",
    "setup:test-device": "ts-node scripts/setup-test-device.ts",
    "demo:trigger": "ts-node scripts/demo-trigger.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.682.0",
    "@aws-sdk/client-dynamodb": "3.682.0",
    "@aws-sdk/client-lambda": "3.682.0",
    "@aws-sdk/client-pinpoint-sms-voice-v2": "3.682.0",
    "@aws-sdk/client-sesv2": "3.682.0",
    "@aws-sdk/client-socialmessaging": "3.682.0",
    "@aws-sdk/lib-dynamodb": "3.682.0",
    "aws-cdk-lib": "2.172.0",
    "constructs": "10.4.2",
    "uuid": "10.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.145",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.0",
    "@types/uuid": "10.0.0",
    "aws-cdk": "2.172.0",
    "esbuild": "0.24.0",
    "eslint": "9.16.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  }
}
